# ==============================================================================
# QueueLess Environment Configuration Example
# Copy this file to .env and adjust variables for your local environment.
# WARNING: NEVER commit .env containing real credentials or secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Application Mode: 'demo' or 'production'
# NOTE: In 'demo' mode, only synthetic data is permitted. NO real patient data!
APP_MODE=demo

# Server Timezone (Must always remain UTC for database storage)
TZ=UTC

# Display Timezone (Configured in clinic settings; Africa/Addis_Ababa)
DISPLAY_TIMEZONE=Africa/Addis_Ababa

# Database Connection URL (PostgreSQL)
DATABASE_URL=postgres://queueless:queueless@localhost:5432/queueless_dev

# Session and Cryptographic Secrets
SESSION_SECRET=replace-with-a-secure-random-64-character-secret

# Public / Staff CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000
